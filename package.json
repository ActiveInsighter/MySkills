{
  "name": "myskills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-skills.mjs && fumadocs-mdx",
    "dev": "npm run content:export && next dev",
    "build": "npm run content:export && next build && node scripts/normalize-output.mjs",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.worker.json",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:types": "wrangler types",
    "e2e": "node scripts/e2e.mjs",
    "content:export": "node scripts/sync-skills.mjs && node scripts/export-content.mjs",
    "verify:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.8",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "^1.61.0",
    "next-themes": "0.4.6",
    "gray-matter": "4.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.152.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.64.1"
  }
}

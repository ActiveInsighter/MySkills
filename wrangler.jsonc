{
  "name": "myskills",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "vars": {
    "SITES": {
      "myskills": {
        "origin": "https://myskills.any1.tech",
        "label": "个人 Skill 知识库"
      }
    }
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/mcp",
      "/mcp/*",
      "/api/download"
    ],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "account_id": "23770063c0a0150df7b1244a636048c8",
  "routes": [
    {
      "pattern": "myskills.any1.tech",
      "custom_domain": true
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2026102401",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}
